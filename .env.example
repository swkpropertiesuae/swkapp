# Required on first run (creates the first manager). Choose a strong password, then change it after login.
SWK_ADMIN_EMAIL=manager@example.com
SWK_ADMIN_PASSWORD=
SWK_ADMIN_NAME=Manager
PORT=8080
# Set to 1 when served over HTTPS (recommended in production).
SECURE_COOKIES=0
# Where the SQLite file lives.
DB_PATH=data/swk.db
