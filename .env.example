# Postgres connection (Neon via the Vercel Marketplace sets DATABASE_URL for you).
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Required on first run only: creates the first manager. Min 10 chars; change it after login.
SWK_ADMIN_EMAIL=manager@example.com
SWK_ADMIN_PASSWORD=
SWK_ADMIN_NAME=Manager
PORT=8080
SECURE_COOKIES=0
